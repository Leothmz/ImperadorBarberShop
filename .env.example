# Configuração da API — copie para .env no servidor e preencha.
# São variáveis de ambiente do processo: no painel da Hostinger, cadastre cada
# linha em Environment Variables. O ASP.NET lê "__" (dois underlines) como
# separador de seção, então Jwt__Secret preenche a seção "Jwt", chave "Secret".

# ── Banco ────────────────────────────────────────────────────────────────────
# SQLite: caminho do arquivo. Use um diretório com escrita e que sobreviva a
# deploy (volume persistente), senão a base é zerada a cada publicação.
ConnectionStrings__DefaultConnection=Data Source=/var/data/imperador_barber.db

# ── URL do frontend ──────────────────────────────────────────────────────────
# Origem exata do site, usada no CORS e nos links enviados ao cliente.
# Sem barra no final. Errar aqui derruba o site inteiro com erro de CORS.
FrontendUrl=https://imperadorbarber.com.br

# ── JWT ──────────────────────────────────────────────────────────────────────
# Secret: mínimo 32 caracteres aleatórios. Gere com:  openssl rand -base64 48
Jwt__Secret=
Jwt__Issuer=ImperadorBarberShop
Jwt__Audience=ImperadorBarberShopFrontend
Jwt__ExpirationMinutes=15

# ── Admin inicial ────────────────────────────────────────────────────────────
# Criado só no primeiro boot, quando ainda não existe nenhum admin. Trocar
# depois aqui NÃO muda a senha de quem já existe — use a tela de trocar senha.
Admin__Email=admin@imperadorbarber.com.br
Admin__Password=

# ── WhatsApp (Evolution API) ─────────────────────────────────────────────────
# Estas três valem em todo boot: alterou aqui e reiniciou, o app assume o valor
# novo. URL sem barra no final.
WHATSAPP__EVOLUTIONAPIURL=http://evolution-api:8080
WHATSAPP__EVOLUTIONAPIKEY=
WHATSAPP__INSTANCENAME=imperador

# Canais de notificação: email | whatsapp | email,whatsapp
# Só semeia o primeiro valor — depois disso, quem manda é a tela
# /admin/whatsapp → Notificações, para não desfazer a escolha a cada restart.
NOTIFICATIONS__CHANNELS=whatsapp

# ── E-mail (opcional se usar só WhatsApp) ────────────────────────────────────
# Na porta 587 o UseSsl=true significa STARTTLS.
Email__SmtpHost=
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__UseSsl=true
Email__FromAddress=noreply@imperadorbarber.com.br
Email__FromName=O Imperador Barber Shop

# ── Cloudinary (fotos de barbeiros e serviços) ───────────────────────────────
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=


# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Vai no ambiente do build do frontend, não da API. É embutido no bundle em
# tempo de build: mudou, precisa buildar de novo.
NEXT_PUBLIC_API_URL=https://api.imperadorbarber.com.br
